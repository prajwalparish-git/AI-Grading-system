# ── Supabase Configuration ───────────────────────────────────────────────────
# Public URL for your Supabase project instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Anon Key — restricted by Row Level Security (RLS) policies
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key — BYPASSES RLS. Server-side only (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Groq LLM API Configuration ──────────────────────────────────────────────
# API Key for Groq Cloud LLM inference (Llama 3 engine)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Target Groq Model for code evaluation (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ── GitHub Integration ──────────────────────────────────────────────────────
# Personal Access Token (PAT) to increase GitHub REST API rate limits
GITHUB_PAT=ghp_your_github_personal_access_token

# ── Upstash Redis (Rate Limiting) ────────────────────────────────────────────
# Upstash REST URL for rate limiting middleware & login/submit endpoints
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io

# Upstash REST Bearer Token
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ── Mock Data Gating (Development Only) ──────────────────────────────────────
# Set to 'true' only if you explicitly want mock data fallback in production
ALLOW_MOCK_ADMIN_DATA=false
